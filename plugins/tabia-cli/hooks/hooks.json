{
  "description": "Block `tabia` commands that pass --yes, the flag that skips the production confirmation.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/no_yes.py\""
          }
        ]
      }
    ]
  }
}
